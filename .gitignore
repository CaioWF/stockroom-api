
# keel: local trivial-change marker (never commit — see .claude/hooks/phase-gate.mjs)
.specify/trivial

# dependencies and build output
node_modules/
dist/

# local environment file, copied from .env.example, never commit
.env
.env.local

# development-only RS256 key pair, generated by scripts/generate-dev-keys.ts.
# Anchored to the repo root (leading slash) — an unanchored `keys/` would also
# match src/auth/infrastructure/keys/ and test/unit/auth/infrastructure/keys/,
# silently excluding real source and test files from git.
/keys/

# agent worktrees — ephemeral, never part of the tree
.claude/worktrees/

# Terraform working files and local inputs
.terraform/
*.tfstate
*.tfstate.backup
backend_override.tf
*.tfvars
!terraform/terraform.tfvars.example
!terraform/fixtures/check.tfvars
# A saved plan holds every attribute and variable value in cleartext — the same
# exposure FR18's write-only arguments exist to prevent.
*.tfplan
tfplan
crash.log
crash.*.log

# Production key material generated by the deploy runbook. Never committed;
# the runbook says to move it to a real secret store and delete the copy.
.deploy-keys/

# Deployment artifact built by the runbook.
/lambda.zip
