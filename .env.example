# Copy this file to the local environment file (dot-env, gitignored) before
# running the app, then export the copy into your shell — nothing loads it
# automatically, because there is no dotenv dependency. README.md step 3 has
# the exact commands. The values below are working local defaults; no value
# here is a real secret. specs/001-authentication/contract.md's Environment
# section explains what each one is for.
#
# Two variables the AWS SDK needs are deliberately absent, because they are
# not part of this app's config schema: AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Any non-empty value works locally. README.md step 3.

# ---------------------------------------------------------------------------
# Required. The app refuses to start when any of these is missing or empty.
# ---------------------------------------------------------------------------

# Selects where the auth module reads its RS256 keys from. Only the literal
# `development` selects the local provider that reads keys/*.pem; anything
# else, including an unset value, selects AWS Parameter Store. The direction
# matters: the Lambda runtime does not set NODE_ENV, so an inverted check
# would make the deployed function fall to the local provider by default.
# Parsed into AppConfig.keySource by src/shared/config/environment.schema.ts.
NODE_ENV=development

# DynamoDB table, created by `npm run db:create-table`.
TABLE_NAME=stockroom-local
AWS_REGION=us-east-1

# Access token issuer (must be a URL) and audience, checked by the guard.
JWT_ISSUER=https://auth.stockroom.test
JWT_AUDIENCE=stockroom-api

# Parameter Store names for the signing key and the verification key set.
# `npm run keys:generate` writes the PEMs under keys/ and prints the kid, but
# does not upload them: the app reads these names from real SSM, since
# auth.module.ts builds its SSMClient with no endpoint override. Until the
# parameters exist, /auth/*, /.well-known/jwks.json and /products fail, while
# /health touches neither storage nor the signing key and works regardless.
# README.md's "The local dev server's real limitation" covers the options.
SIGNING_KEY_PARAMETER_NAME=/stockroom/local/signing-key
VERIFICATION_KEYS_PARAMETER_NAME=/stockroom/local/verification-keys

# ---------------------------------------------------------------------------
# Optional. Blank means "use the default". The defaults are declared in
# src/shared/config/environment.schema.ts and appear below as comments rather
# than as values, so the two cannot drift apart.
# ---------------------------------------------------------------------------

# The compose service in docker-compose.yml, reached from the host. Leave
# blank to talk to a real DynamoDB instead.
DYNAMODB_ENDPOINT=http://localhost:8000

# Token lifetimes, in seconds. Defaults: 900, 604800, 2592000.
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
SESSION_CEILING_SECONDS=

# Public-route throttling, per client address.
# Defaults: credentials 10/60s, refresh 60/60s, jwks 120/60s.
THROTTLE_CREDENTIALS_LIMIT=
THROTTLE_CREDENTIALS_WINDOW_SECONDS=
THROTTLE_REFRESH_LIMIT=
THROTTLE_REFRESH_WINDOW_SECONDS=
THROTTLE_JWKS_LIMIT=
THROTTLE_JWKS_WINDOW_SECONDS=

# Protected-route throttling, per verified account. Default: 100/60s.
THROTTLE_AUTHENTICATED_LIMIT=
THROTTLE_AUTHENTICATED_WINDOW_SECONDS=

# Throttle counter bounds and degraded-mode fallback.
# Defaults: saturation 2, fallback 1, 10000 entries, 500 ms, 3 attempts.
THROTTLE_COUNTER_SATURATION_FACTOR=
THROTTLE_LOCAL_FALLBACK_FACTOR=
THROTTLE_LOCAL_CACHE_MAX_ENTRIES=
THROTTLE_STORE_DEADLINE_MILLISECONDS=
THROTTLE_STORE_MAX_ATTEMPTS=
