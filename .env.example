# Copy this file to the local environment file (dot-env, gitignored) before
# running the app. Names only, below — no value here is a real secret. See
# specs/001-authentication/contract.md for how each is used.

# DynamoDB table and endpoint.
TABLE_NAME=
AWS_REGION=
# The compose service in docker-compose.yml, from the host: http://localhost:8000
DYNAMODB_ENDPOINT=

# Access token issuer and audience, checked by the guard.
JWT_ISSUER=
JWT_AUDIENCE=

# Token lifetimes, in seconds.
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
SESSION_CEILING_SECONDS=

# Parameter Store names for the signing key and the verification key set.
SIGNING_KEY_PARAMETER_NAME=
VERIFICATION_KEYS_PARAMETER_NAME=

# Public-route throttling, per client address.
THROTTLE_CREDENTIALS_LIMIT=
THROTTLE_CREDENTIALS_WINDOW_SECONDS=
THROTTLE_REFRESH_LIMIT=
THROTTLE_REFRESH_WINDOW_SECONDS=
THROTTLE_JWKS_LIMIT=
THROTTLE_JWKS_WINDOW_SECONDS=

# Protected-route throttling, per verified account.
THROTTLE_AUTHENTICATED_LIMIT=
THROTTLE_AUTHENTICATED_WINDOW_SECONDS=

# Throttle counter bounds and degraded-mode fallback.
THROTTLE_COUNTER_SATURATION_FACTOR=
THROTTLE_LOCAL_FALLBACK_FACTOR=
THROTTLE_LOCAL_CACHE_MAX_ENTRIES=
THROTTLE_STORE_DEADLINE_MILLISECONDS=
THROTTLE_STORE_MAX_ATTEMPTS=
